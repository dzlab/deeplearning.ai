<mxfile host="app.diagrams.net" type="device"><diagram id="m4-lora" name="LoRA Decomposition"><mxGraphModel dx="980" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="540" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Module 4 (Weight-space) &#8212; LoRA Low-Rank Decomposition" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="920" height="40" as="geometry"/></mxCell><mxCell id="eq" value="W&#8242; = W + &#945; &#183; (B &#183; A)" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="920" height="30" as="geometry"/></mxCell><mxCell id="frozen_lbl" value="frozen" style="text;html=1;fontSize=11;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="120" height="20" as="geometry"/></mxCell><mxCell id="W" value="W" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;verticalAlign=top;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="80" y="155" width="120" height="120" as="geometry"/></mxCell><mxCell id="W_dim" value="d_out &#215; d_in&#10;(base weight, untouched)" style="text;html=1;fontSize=11;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="160" height="34" as="geometry"/></mxCell><mxCell id="plus" value="+" style="text;html=1;fontSize=28;align=center;" vertex="1" parent="1"><mxGeometry x="215" y="195" width="40" height="40" as="geometry"/></mxCell><mxCell id="alpha" value="&#945; &#183;" style="text;html=1;fontSize=14;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="215" y="235" width="40" height="20" as="geometry"/></mxCell><mxCell id="trained_lbl" value="trained adapter (the &#8220;recipe card&#8221;)" style="text;html=1;fontSize=11;fontColor=#555555;align=center;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="270" y="130" width="220" height="20" as="geometry"/></mxCell><mxCell id="B" value="B" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="280" y="155" width="30" height="120" as="geometry"/></mxCell><mxCell id="B_dim" value="d_out &#215; r" style="text;html=1;fontSize=11;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="265" y="280" width="60" height="20" as="geometry"/></mxCell><mxCell id="dot" value="&#183;" style="text;html=1;fontSize=28;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="195" width="30" height="40" as="geometry"/></mxCell><mxCell id="A" value="A" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="195" width="130" height="34" as="geometry"/></mxCell><mxCell id="A_dim" value="r &#215; d_in" style="text;html=1;fontSize=11;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="235" width="130" height="20" as="geometry"/></mxCell><mxCell id="eqls" value="=" style="text;html=1;fontSize=28;align=center;" vertex="1" parent="1"><mxGeometry x="505" y="195" width="40" height="40" as="geometry"/></mxCell><mxCell id="eff_lbl" value="effective weight at inference" style="text;html=1;fontSize=11;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="160" height="20" as="geometry"/></mxCell><mxCell id="Wp" value="W&#8242;" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;verticalAlign=top;spacingTop=20;" vertex="1" parent="1"><mxGeometry x="580" y="155" width="120" height="120" as="geometry"/></mxCell><mxCell id="Wp_dim" value="d_out &#215; d_in&#10;(same shape as W)" style="text;html=1;fontSize=11;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="280" width="160" height="34" as="geometry"/></mxCell><mxCell id="cheap" value="Why it&#8217;s cheap&#10;Train only B and A (r &#183; (d_out + d_in) params)&#10;instead of all of W (d_out &#183; d_in).&#10;r &#8810; min(d_in, d_out), so the adapter is&#10;100s&#8211;1000s&#215; smaller than the base." style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="150" width="230" height="130" as="geometry"/></mxCell><mxCell id="note" value="Low-rank decomposition: r &#8810; min(d_in, d_out). Base W stays frozen on the shelf; only the small B&#183;A &#8220;recipe card&#8221; is learned and loaded. Setup goes through peft.LoraConfig + peft.get_peft_model &#8212; no from-scratch tensor math. Full derivation: DeepLearning.AI&#8217;s LoRA / PEFT short courses." style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="930" height="70" as="geometry"/></mxCell><mxCell id="eW" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="frozen_lbl" target="W"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
