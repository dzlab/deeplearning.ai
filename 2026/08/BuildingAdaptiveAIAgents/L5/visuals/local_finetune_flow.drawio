<mxfile host="app.diagrams.net" type="device"><diagram id="m4-local-flow" name="Local Unsloth Fine-Tune Flow"><mxGraphModel dx="1100" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="540" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Module 4 &#8212; Local Unsloth Fine-Tune Flow (QLoRA on unsloth/gemma-3n-E4B-it)" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry"/></mxCell>

<mxCell id="gpu_lane" value="Instructor A10 (local GPU)" style="swimlane;html=1;fontSize=14;fontStyle=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#FFFFFF;horizontal=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="200" as="geometry"/></mxCell>
<mxCell id="corpus" value="Refusal corpus&#10;build_refusal_corpus&#10;(refuse unknown / answer known&#10;voyage ids &#8212; NO facts)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;rounded=1;" vertex="1" parent="gpu_lane"><mxGeometry x="30" y="60" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="unsloth" value="Unsloth + 4-bit QLoRA&#10;train fresh from base&#10;(minutes on one A10)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;rounded=1;" vertex="1" parent="gpu_lane"><mxGeometry x="270" y="60" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="adapter" value="PEFT adapter&#10;v1 / v2&#10;(~321 MB each &#8212; GITIGNORED)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;rounded=1;" vertex="1" parent="gpu_lane"><mxGeometry x="510" y="60" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="gen" value="Generate &amp; cache&#10;base + v1 + v2 over the&#10;held-out eval prompts" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;rounded=1;" vertex="1" parent="gpu_lane"><mxGeometry x="750" y="60" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="note_train" value="no warm-start: each arm from frozen base" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="gpu_lane"><mxGeometry x="260" y="22" width="210" height="30" as="geometry"/></mxCell>

<mxCell id="repo_lane" value="Repo / Attendee (no GPU)" style="swimlane;html=1;fontSize=14;fontStyle=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#FFFFFF;horizontal=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1100" height="180" as="geometry"/></mxCell>
<mxCell id="cache" value="gemma_cached_responses.json&#10;(COMMITTED &#8212; base/v1/v2 generations)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;fontStyle=1;" vertex="1" parent="repo_lane"><mxGeometry x="420" y="40" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="notebook" value="notebook (CPU laptop)&#10;reads every generation from the cache&#10;&#8212; live train/gen only on cache miss + GPU" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;rounded=1;" vertex="1" parent="repo_lane"><mxGeometry x="780" y="30" width="280" height="100" as="geometry"/></mxCell>

<mxCell id="e1" value="train on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="gpu_lane" source="corpus" target="unsloth"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="gpu_lane" source="unsloth" target="adapter"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="load + infer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="gpu_lane" source="adapter" target="gen"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="commit cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gen" target="cache"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="replay (no GPU)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontStyle=2;" edge="1" parent="repo_lane" source="cache" target="notebook"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note" value="OCI removed (instructor-approved): the whole flow is local. Attendees run INFERENCE ONLY from the committed cache; the adapters are gitignored (~321MB, regenerate via run.py train). See data/adapters/README.md." style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1100" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
