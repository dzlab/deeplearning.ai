<mxfile host="app.diagrams.net" type="device"><diagram id="m4-analogy" name="Recipe Card Analogy"><mxGraphModel dx="980" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Module 4 (Weight-space) &#8212; The Recipe Card on the Fridge" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="920" height="40" as="geometry"/></mxCell><mxCell id="chef" value="Head chef = ROUTER&#10;decides per ticket which recipe&#10;(with or without the card) the cook follows" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="280" height="80" as="geometry"/></mxCell><mxCell id="ticket" value="Incoming ticket (task)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="180" height="50" as="geometry"/></mxCell><mxCell id="cook" value="Base model = LINE COOK&#10;Qwen/Qwen2.5-1.5B-Instruct&#10;already knows generic recipes;&#10;stays untouched on the shelf" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="260" width="260" height="110" as="geometry"/></mxCell><mxCell id="card" value="QLoRA adapter = RECIPE CARD&#10;pinned to the fridge&#10;&#10;&#8220;in THIS kitchen, sear before braising;&#10;the customer last week wanted medium-rare&#8221;&#10;&#10;a small, loadable card &#8212; not a new cook" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;dashed=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="320" height="150" as="geometry"/></mxCell><mxCell id="base_path" value="base&#10;(card NOT loaded)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="430" width="200" height="50" as="geometry"/></mxCell><mxCell id="spec_path" value="specialised&#10;(base + recipe card loaded)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="320" height="50" as="geometry"/></mxCell><mxCell id="link" value="Pairs with Module 3&#8217;s &#8220;two cooks, one recipe&#8221;: M3 swaps the COOK (latent-space adapter); M4 swaps the RECIPE CARD (weight-space adapter)." style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="900" height="40" as="geometry"/></mxCell><mxCell id="e_t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ticket" target="chef"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_c1" value="route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="1" source="chef" target="cook"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_load" value="optionally load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;fontStyle=2;" edge="1" parent="1" source="card" target="cook"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="cook" target="base_path"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="card" target="spec_path"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
